rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isListingOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    // Users collection: each user can read/write only their own profile
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwnUser(uid);
      allow update: if isOwnUser(uid);
      allow delete: if false;
    }

    // Exchange listings: all signed-in users can read; only owner can write/delete
    match /exchange_listings/{listingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isListingOwner(resource.data.ownerId);
      allow delete: if isListingOwner(resource.data.ownerId);
    }

    // Legacy exchange chat collections remain read-only for signed-in clients.
    // Node.js Admin SDK bypasses these rules and performs all chat writes.
    match /chats/{chatId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /messages/{chatId} {
      allow read: if isSignedIn();
      allow write: if false;

      match /items/{messageId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    match /exchange_threads/{threadId} {
      allow read: if isSignedIn();
      allow write: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }
  }
}
