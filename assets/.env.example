# Copy to assets/.env for local runs. This file is bundled into the public web
# app, so only put browser-safe values here. On Vercel it is generated by
# scripts/write-web-env.js from the project's environment variables.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_EXCHANGE_BUCKET=exchange-images
CHAT_BACKEND_URL=http://localhost:5051
FRAGELLA_WIDGET_ID=

# Optional: point local runs at a deployed /api (chatbot + fragrance search).
# API_BASE_URL=https://<your-deployment>.vercel.app

# Server-only secrets, set as Vercel environment variables (never in this file):
# GROQ_API_KEY, PERFUME_CHATBOT_MODEL, FRAGELLA_API_KEY, FRAGELLA_BASE_URL
